# PostHog Analytics
# ─────────────────
# Copy this file to .env.local and fill in your PostHog project API key.
# Sign up free at https://posthog.com — the "Hobby" plan is free for up to 1M events/month.
#
# 1. Create a project at https://us.posthog.com (or https://eu.posthog.com for EU data residency)
# 2. Go to Project Settings → Project API key
# 3. Paste the key below
#
# Leave VITE_POSTHOG_KEY empty (or unset) to disable analytics entirely — useful for local dev.

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
